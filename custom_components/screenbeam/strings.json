{
  "config": {
    "flow_title": "{host}",
    "step": {
      "user": {
        "description": "Connect to a ScreenBeam MoCA (Ethernet over coax) adapter. Add each adapter of the pair separately.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "host": "IP address or hostname of the adapter's web interface.",
          "username": "Login of the adapter's web interface.",
          "password": "Password of the adapter's web interface."
        }
      },
      "discovery_confirm": {
        "description": "A ScreenBeam adapter was found at {host}. Enter the login of its web interface.",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reauth_confirm": {
        "description": "The adapter at {host} rejected the login. Enter the current one.",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reconfigure": {
        "description": "Change the address or login of the adapter.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "unique_id_mismatch": "This address belongs to a different adapter."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "model": "Model",
          "scan_interval": "Poll interval"
        },
        "data_description": {
          "model": "Model printed on the adapter's label, e.g. ECB7250. The adapter does not report it, so it is shown as \"MoCA 2.5 adapter\" until you set it.",
          "scan_interval": "How often to read the adapter. One poll is about a dozen small requests."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "coax_link": {
        "name": "Coax link"
      },
      "coax_encryption": {
        "name": "Coax encryption"
      },
      "network_coordinator": {
        "name": "Network coordinator"
      }
    },
    "sensor": {
      "tx_phy_rate": {
        "name": "Coax TX PHY rate"
      },
      "rx_phy_rate": {
        "name": "Coax RX PHY rate"
      },
      "tx_packet_rate": {
        "name": "Ethernet TX rate"
      },
      "rx_packet_rate": {
        "name": "Ethernet RX rate"
      },
      "moca_nodes": {
        "name": "MoCA nodes"
      },
      "tx_packets": {
        "name": "Ethernet TX packets"
      },
      "rx_packets": {
        "name": "Ethernet RX packets"
      },
      "tx_errors": {
        "name": "Ethernet TX errors"
      },
      "rx_errors": {
        "name": "Ethernet RX errors"
      },
      "tx_dropped": {
        "name": "Ethernet TX dropped"
      },
      "rx_dropped": {
        "name": "Ethernet RX dropped"
      },
      "moca_version": {
        "name": "MoCA version"
      },
      "beacon_channel": {
        "name": "Beacon channel"
      },
      "primary_channel": {
        "name": "Primary channel"
      },
      "bonded_channels": {
        "name": "Bonded channels"
      },
      "counters_reset": {
        "name": "Last counter reset"
      }
    }
  }
}
