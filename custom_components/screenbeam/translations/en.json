{
  "config": {
    "flow_title": "{host}",
    "step": {
      "user": {
        "description": "Connect to a ScreenBeam MoCA (Ethernet over coax) adapter. Add each adapter of the pair separately.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or hostname of the adapter's web interface.",
          "username": "Login of the adapter's web interface.",
          "password": "Password of the adapter's web interface."
        }
      },
      "discovery_confirm": {
        "description": "A ScreenBeam adapter was found at {host}. Enter the login of its web interface.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "description": "The adapter at {host} rejected the login. Enter the current one.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "reconfigure": {
        "description": "Change the address or login of the adapter.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Device is already configured",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful",
      "unique_id_mismatch": "This address belongs to a different adapter."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Poll interval"
        },
